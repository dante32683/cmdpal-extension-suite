<Project>
  <PropertyGroup>
    <Platforms>x64;ARM64</Platforms>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <_SkipUpgradeNetAnalyzersNuGetWarning>true</_SkipUpgradeNetAnalyzersNuGetWarning>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
    <!-- The Command Palette SDK winmd ships without implementation metadata; APPX1707 is external and non-actionable. -->
    <NoWarn>$(NoWarn);APPX1707</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS8305;IL2081</WarningsNotAsErrors>
    <PlatformTarget>$(Platform)</PlatformTarget>
  </PropertyGroup>
</Project>
