# Normalize line endings so a clone on any machine does not produce
# whole-file diffs driven by the local core.autocrlf setting.
* text=auto

# Sources and docs use LF; PowerShell scripts use Windows-native CRLF.
*.cs        text eol=lf diff=csharp
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.sln       text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.appxmanifest text eol=lf

# Scripts Windows tooling reads directly.
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Never touch binaries.
*.png       binary
*.ico       binary
*.jpg       binary
*.pri       binary
*.dll       binary
*.exe       binary
*.pfx       binary
